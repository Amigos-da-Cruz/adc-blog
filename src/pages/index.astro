---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleListing from '../components/ArticleListing.astro';
import { getArticles } from '../lib/content';

const articles = await getArticles();
---

<BaseLayout>
  <section class="hero">
    <div class="hero__copy">
      <span class="adc-eyebrow">Amigos da Cruz · Blogue</span>
      <h1 lang="la">Omnia autem probate,<br /><em>quod bonum est tenete.</em></h1>
      <p>«Examinai tudo; guardai o que é bom.» <a href="https://press.vatican.va/archive/bible/nova_vulgata/documents/nova-vulgata_nt_epist-i-thessalonicenses_lt.html">1 Ts 5, 21</a>. Notícias e comentários para acompanhar a vida da Igreja com conhecimento e discernimento.</p>
      <a class="hero__link" href="#artigos">Ler as publicações <span aria-hidden="true">↗</span></a>
    </div>
    <aside class="hero__aside" aria-label="Citação do livro dos Provérbios">
      <span class="adc-eyebrow">A procura do conhecimento</span>
      <p lang="la">Auris sapientium quaerit doctrinam.</p>
      <div class="hero__aside-foot">«O ouvido dos sábios procura instrução.» <a href="https://www.vatican.va/archive/bible/nova_vulgata/documents/nova-vulgata_vt_proverbiorum_lt.html">Pr 18, 15</a></div>
    </aside>
  </section>

  <div id="artigos" class="page-container">
    <ArticleListing articles={articles.slice(0, 9)} heading="Publicações recentes" empty="Ainda não há artigos publicados. O arquivo ficará disponível aqui." />
    <div class="browse-links">
      <a href="/noticias">Todas as notícias <span aria-hidden="true">→</span></a>
      <a href="/comentarios">Todos os comentários <span aria-hidden="true">→</span></a>
    </div>
  </div>
</BaseLayout>
