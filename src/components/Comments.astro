---
import { CommentsApp } from './CommentsApp';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const configured = Boolean(import.meta.env.MONGODB_URI && import.meta.env.MONGODB_DB && import.meta.env.COMMENTS_ADMIN_TOKEN && import.meta.env.TURNSTILE_SECRET_KEY && import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
---

<section id="comentarios" class="article-comments" aria-label="Comentários dos leitores">
  {configured ? <CommentsApp slug={slug} siteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY!} client:load /> : (
    <><h2>Comentários</h2><p class="article-comments__intro">Os comentários estarão disponíveis em breve.</p></>
  )}
</section>
