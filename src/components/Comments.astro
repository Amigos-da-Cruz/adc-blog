---
interface Props {
  articleId: string;
}

const { articleId } = Astro.props;
const websiteId = import.meta.env.PUBLIC_HYVOR_WEBSITE_ID;
---

<section id="comentarios" class="article-comments" aria-labelledby="comments-title">
  <h2 id="comments-title">Comentários</h2>
  {websiteId ? (
    <>
      <p class="article-comments__intro">Participa na conversa ou responde a outros leitores.</p>
      <hyvor-talk-comments website-id={websiteId} page-id={articleId} page-language="pt"></hyvor-talk-comments>
      <script is:inline async type="module" src="https://talk.hyvor.com/embed/embed.js"></script>
    </>
  ) : (
    <p class="article-comments__intro">Os comentários estarão disponíveis em breve.</p>
  )}
</section>
